rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 즐겨찾기: 본인 것만
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 패치 별점: 누구나 읽기, 로그인한 사람은 stars 안의 자기 칸만 1~5로 바꾸거나 지움(취소)
    match /patches/{pid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['stars'])
        && request.resource.data.stars.keys().hasOnly([request.auth.uid])
        && okStar(request.resource.data.stars[request.auth.uid]);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stars'])
        && request.resource.data.stars.diff(resource.data.stars).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.stars) || okStar(request.resource.data.stars[request.auth.uid]));
      function okStar(n) { return n is int && n >= 1 && n <= 5; }

      // 댓글: 누구나 읽기, 본인 이름으로만 쓰기(1~1000자), 본인만 삭제, 좋아요/싫어요는 자기 칸만
      match /comments/{cid} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid','name','text','ts','up','down'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.ts == request.time
          && request.resource.data.up.size() == 0 && request.resource.data.down.size() == 0;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['up','down'])
          && request.resource.data.up.diff(resource.data.up).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.down.diff(resource.data.down).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.up && request.auth.uid in request.resource.data.down);
      }
    }
  }
}
